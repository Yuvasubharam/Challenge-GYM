# Copy to .env on the gym PC, then run .\install_autostart.ps1 once.
CLOUD_URL=https://challenge-gym-device.<your-subdomain>.workers.dev
AGENT_TOKEN=paste-the-agent-token
# The device is found automatically on this PC's network (port 4370 + serial check).
# DEVICE_IP is only the first guess; the last IP that worked is remembered in agent_state.json.
DEVICE_SN=CUB7252100258
DEVICE_IP=192.168.0.215
DEVICE_PORT=4370
DEVICE_PASSWORD=0
AUTO_DISCOVER=1
SCAN_EVERY_SEC=60
# Extra networks to search if the device is on a different subnet than the PC, e.g. 192.168.1.0/24
SCAN_SUBNETS=
COMMAND_POLL_SEC=15
ATTENDANCE_EVERY_MIN=5
ROSTER_EVERY_MIN=30
ETTL_EVERY_MIN=60
ETTL_DB=C:\Program Files (x86)\eSSL\eTimeTrackLite\eTimeTrackLite1.mdb
BACKFILL_DAYS=3
